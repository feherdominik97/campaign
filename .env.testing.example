APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
ARTISAN_KEY_GENERATOR=false

# Other environment variables you may need during testing
PUSHER_APP_ID=null
PUSHER_APP_KEY=null
PUSHER_APP_SECRET=null

# Disable any external services or API integrations in the testing environment
TWILIO_SID=null
TWILIO_AUTH_TOKEN=null

# Stripe or other payment service mockup or null keys for testing
STRIPE_KEY=null
STRIPE_SECRET=null

# Other custom environment variables you might need for testing
